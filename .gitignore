# Dependencies
node_modules/
test-render/node_modules/

# Build outputs (generated, can be rebuilt)
dist/*.jsx
# Keep dist/index.html for GitHub Pages deployment
!dist/index.html

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp

# Reference/scratch materials
articles/*/ref/

# Claude Code / Sidecar local state
.claude/

# Intermediate project page bundles (rebuilt by scripts/build-pages.js)
dist/pages/

# Film reel originals stay local; the build publishes web copies to assets/photos/reel-web/
assets/photos/reel/*
!assets/photos/reel/.gitkeep
